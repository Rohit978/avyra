# Application Settings
ENVIRONMENT=development
PROJECT_NAME="Cineverse"
API_V1_STR="/api/v1"
SECRET_KEY="supersecretchangeinproduction"
CORS_ORIGINS='["http://localhost:3000", "http://127.0.0.1:3000"]'

# Database Settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cineverse
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/cineverse"
SYNC_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cineverse"

# External Provider API Keys (Fill with your keys)
TMDB_API_KEY=""
ANILIST_API_URL="https://graphql.anilist.co"

# Configured Player Embeds
VIDBOLT_MOVIE_URL_TEMPLATE="https://vidbolt.xyz/movie/{TMDB_ID}"
VIDBOLT_TV_URL_TEMPLATE="https://vidbolt.xyz/tv/{id}/{s}/{e}"
REELSDOWNLOAD_URL_TEMPLATE="https://embed.reelsdownload.online/player/{TMDB_ID}?key=k_5661ac637169a1733857dc50"

